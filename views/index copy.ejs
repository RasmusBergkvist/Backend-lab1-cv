<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
    <title>CV</title>
</head>

<body>
    <header>
        <h1>CV</h1>
    </header>
    <main>
        <h2>Kurser</h2>
        <p>Här visas kurserna som jag har läst</p>
        <div class="courselist">
            <!-- Här visas kurser som jag lagt till   -->

            <% courses.forEach(course=> {
                %>

                <article>
                    <h3>
                        <%= course.coursecode %>
                            <%= course.coursename %>
                    </h3>
                    <p>Progression: <%= course.progression %>
                    </p>
                    <span><a class="syllabus" href="<%= course.syllabus %>" target="_blank"
                            rel="noopener noreferrer">Kursplan för <%= course.coursecode %></a></span>
                    <span><a class="delete" href="/delete/<%=course.id %>">Radera kurs</a>
                        <a class="edit" href="/edit/<%=course.id %>">Radera kurs</a></span>
                </article>


                <% }); %>
        </div>
    </main>
</body>

</html>