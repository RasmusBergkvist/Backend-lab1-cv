<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
    <title>CV</title>
</head>

<body>
    <main>
        <h1>Lägg till kurser</h1>
        <form method="post">
            <label for="coursecode">Kurskod:</label>
            <span class="error"><%= coursecodeError %></span>
            <input type="text" id="coursecode" name="coursecode" placeholder="Ex. DT207G">

            <label for="coursename">Kursnamn:</label>
            <span class="error"><%= coursenameError %></span>
            <input type="text" id="coursename" name="coursename" placeholder="Ex. Backend-baserad webbutveckling">

            <label for="syllabus">Kursplan:</label>
            <span class="error"><%= syllabusError %></span>
            <input type="text" id="syllabus" name="syllabus" placeholder="Url till kursplan">

            <label for="progression">Progression:</label>
            <span class="error"><%= progressionError %></span>
            <input type="text" id="progression" name="progression" placeholder="Ex. A, B eller C">

            <input type="submit" class="button" value="Lägg till kurs">
        </form>
    </main>
</body>

</html>