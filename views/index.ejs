<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>CV</title>
</head>

<body>
    <header>
        <h1>CV</h1>
    </header>
    <main>
        <h2>Kurser</h2>
        <p>Här visas kurserna som jag har läst:</p>
        <div class="courselist">

<!-- Felmeddelande visas om databasen inte kan hämta data   -->            
        <% if (locals.databaseError) { %>
        <span class="error"><%= databaseError %></span>
        <% } %>

        <!-- Felmeddelande visas om kursen inte kunde raderas   -->            
        <% if (locals.deleteError) { %>
        <span class="error"><%= deleteError %></span>
        <% } %>

    
        <!-- Här visas kurser som finns i databasen   -->
         <% if(courses.length === 0 && !locals.databaseError) { %>
            <p>Du har inga kurser inladga. <a add-course href="/add">Lägg till kurs</a></p>
            
        <% } else { %>
        
            <% courses.forEach(course=> {
                %>

                <article>
                    <h3>
                        <%= course.coursecode %>
                            <%= course.coursename %>
                    </h3>
                    <p>Progression: <%= course.progression %>
                    </p>
                    <div class="article-links">
                        <a class="syllabus" href="<%= course.syllabus %>" target="_blank"
                            rel="noopener noreferrer">Kursplan för <%= course.coursecode %></a>
                        <div class="right-links">
                            <a class="delete" href="/delete/<%=course.id %>">Radera kurs</a>
                            <a class="edit" href="/edit/<%=course.id %>">Redigera kurs</a>
                        </div>
                    </div>
                </article>


                <% }); %>

      <% } %>
        </div>
    </main>
</body>

</html>